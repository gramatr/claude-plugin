{
  "description": "grāmatr hooks. SessionStart writes git context to .gramatr/git-context.json via project-init.js (zero-auth, zero-network). UserPromptSubmit routes prompts via route_request on the HTTP gramatr server. Stop records turn feedback via record_turn_feedback. SessionEnd auto-saves a structured handoff via auto_save_handoff — the adapter composes the 5-section handoff server-side from session state so it can never be forgotten or silently truncated (#2768 PR-Hook-2 / #3260). The architecture is client-agnostic (v0.20.18 #2756) — Claude Code is one consumer; Cursor, Codex, ChatGPT plugins drop in later by passing their own client_session_id with a matching client_type literal. See #2768 for the full 5-hook queue. When the context window nears capacity, the UserPromptSubmit hook injects a MANDATORY /compact directive instead of silently blocking compaction.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/memory-gate.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/git-gate.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/input-validator.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/task-quality-gate.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/subagent-route.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/project-init.js"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/init-identity.js"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/headless-login-transport.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/compact-advisor.js"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/ups-route.js"
            ],
            "timeout": 12
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/track-tokens.js"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/stop-feedback.js"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/classification-feedback.js"
            ],
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/save-reflection-gate.js"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/compliance-telemetry.js"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/session-end-seal.js"
            ],
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:gramatr:gramatr",
            "tool": "auto_save_handoff",
            "input": {
              "client_session_id": "${session_id}",
              "client_type": "claude-code",
              "reason": "${reason}",
              "hook_response": true
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:gramatr:gramatr",
            "tool": "auto_save_handoff",
            "input": {
              "client_session_id": "${session_id}",
              "client_type": "claude-code",
              "reason": "${trigger}",
              "hook_response": true
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/git-commit-handoff.js"
            ],
            "timeout": 8
          }
        ]
      }
    ]
  }
}
